"use client";
import {useState} from "react";
import Link from "next/link";

const categories = [
  { label: "IT & Technology", href: "/knowledge/it" },
  { label: "Travel", href: "/knowledge/travel" },
  { label: "Investment", href: "/knowledge/investment" },
  { label: "Life & Society", href: "/knowledge/life" },
];

export default function KnowledgeDropdown(){
    const [isOpen, setIsOpen] = useState(false);


  return (
    <div className="relative">
      <button
        type="button"
        onClick={() => setIsOpen(!isOpen)}
        aria-expanded={isOpen}
        aria-haspopup="menu"
        className="transition-colors hover:text-blue-500"
      >
        Knowledge ▾
      </button>

      {isOpen && (
        <div className="absolute left-0 top-full z-50 mt-3 w-52 rounded-xl border border-zinc-200 bg-white p-2 text-zinc-900 shadow-lg dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-100">
          {categories.map((category) => (
            <Link
              key={category.href}
              href={category.href}
              onClick={() => setIsOpen(false)}
              className="block rounded-lg px-3 py-2 text-sm transition-colors hover:bg-zinc-100 dark:hover:bg-zinc-800"
            >
              {category.label}
            </Link>
          ))}
        </div>
      )}
    </div>
  );

}